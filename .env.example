# Control-plane database (docker-compose.dev.yml default)
DATABASE_URL=postgres://compandium:compandium@localhost:5544/compandium

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 bytes base64 — encrypts tenant/agent/connector secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY=

# Provisioning: docker (local dev) or fly (production)
COMPANDIUM_PROVISIONER=docker
COMPANDIUM_DEFAULT_REGION=iad
# Tenant image ref: local docker tag (docker) or pullable registry ref (fly)
TENANT_IMAGE=compandium-tenant

# Fly.io (production provisioning)
FLY_API_TOKEN=
FLY_ORG_SLUG=

# Bundled AI provider keys handed to tenant instances (Phase 1+)
BUNDLED_ANTHROPIC_API_KEY=
BUNDLED_OPENAI_API_KEY=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
